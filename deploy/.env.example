# Compose overrides for the MemSOC stack.
#
# Copy to deploy/.env to use:   cp deploy/.env.example deploy/.env
#
# IMPORTANT: Compose reads THIS directory's .env for ${...} interpolation,
# because the project directory is the directory holding
# docker-compose.yml -- not the repository root. The root .env is a
# different thing: it is passed into the report and controller containers
# via `env_file` and holds GROQ_API_KEY.
#
#   deploy/.env   non-secret settings below (ports, dataset location)
#   ../.env       runtime secrets for the containers (GROQ_API_KEY)
#
# Nothing here is secret, but deploy/.env is gitignored anyway so local
# port choices do not end up in commits.

# --- Published host ports -------------------------------------------
# Change these if something else on the host already owns one. The
# container-side ports never change.
#MEMSOC_DETECTION_PORT=8000
#MEMSOC_REPORT_PORT=8001
#MEMSOC_DASHBOARD_PORT=8080

# --- Dataset ---------------------------------------------------------
# Directory holding NF-UNSW-NB15-v3.csv, at any depth. Relative paths are
# resolved against this directory. Defaults to ../data.
#MEMSOC_HOST_DATA=../data
