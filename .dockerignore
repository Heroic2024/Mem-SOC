# The dataset is multi-GB and cannot live in the image. It is bind-mounted
# at /data instead -- see deploy/docker-compose.yml.
data/

# Runtime output: regenerated inside the container, or mounted as a volume.
artifacts/
logs/
*.log

# Model pickles are the one large thing that IS baked into the detection
# image, so models/ is deliberately NOT excluded here.

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# Node: the dashboard image runs `npm ci` itself.
node_modules/
dashboard/dist/

# Dev environment
.git/
.gitignore
.claude/
.env
soc-triage/

# Not needed at runtime.
docs/
*.ipynb
