# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# --- Secrets ---
.env

# --- Node ---
node_modules/
dashboard/dist/

# --- Dataset (multi-GB, bind-mounted at /data instead) ---
/data/

# --- Runtime output -------------------------------------------------
# Everything the system writes at runtime lands in artifacts/ or logs/.
# Generated flows, the stream cursor, captured model outputs and
# generated reports are all reproducible from a seeded run, so none of
# them belong in version control.
/artifacts/
/logs/

# Application logs wherever they land.
*.log

# --- Misc ---
*.tmp
*.zip
*.h5
*.parquet
soc-triage/

# NOTE: models/*.pkl ARE tracked on purpose. The detector is frozen after
# training (PROJECT_BRIEF.md section 3) and the weights must be reproducible
# from a checkout, so the two LightGBM pickles are committed.
